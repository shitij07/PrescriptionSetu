# ============================================================
# PrescriptionSetu — Environment Variables (Template)
# Copy this file to .env and fill in real values.
# No real secrets are stored in this template.
# ============================================================

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/prescriptionsetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prescriptionsetu

# --- Redis (7+) ---
REDIS_URL=redis://redis:6379

# --- Google Cloud Vision API ---
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key-here

# --- Bhashini API ---
BHASHINI_API_KEY=your-bhashini-api-key-here
BHASHINI_PIPELINE_ID=your-bhashini-pipeline-id-here

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- API Service (Node.js/Express) ---
NODE_ENV=development
PORT=3000

# --- OCR Service (Python/FastAPI) ---
PYTHON_ENV=development
OCR_SERVICE_PORT=8000

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3000